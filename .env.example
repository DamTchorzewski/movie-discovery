# TMDB

# The TMDB API key (v3) the browser sends with every request. Get it at themoviedb.org → Settings → API.
# It ships to the browser on purpose (a static site has no server), so it is public and rate limited by TMDB.
# GitHub: repository variable. Required for a real build; empty = the app shows a "no API key" screen.
VITE_TMDB_API_KEY=

# Site

# The public address of the deployed site, with its path (for example a GitHub Pages project address).
# GitHub: not needed, the deploy workflow reads it from the Pages settings; a repository variable only for a custom domain.
# Optional. Empty = a build for /tmdb-movie-browser/ with no canonical URL.
SITE_URL=
